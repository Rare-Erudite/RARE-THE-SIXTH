# Optional server-side provider credentials. Never expose these to Vite or the APK.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional server-side application settings.
RARE_API_TOKEN=
# Required to enable Developer Space. Without this, developer login is disabled.
RARE_DEV_KEY=

# Optional public backend URL for a separately hosted client or Android APK build.
# For a same-origin web deployment, leave blank: the app uses the current origin.
VITE_BACKEND_URL=
